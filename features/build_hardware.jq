{
    DUMP_FILE: $dump,
    firmware: {
        Vendor: $vendor,
        Version: $firmware_version,
        Release_Date: $release_date
    },
    system: {
        Manufacturer: $manufacturer,
        Product_name: $prod_name,
        Serial: $serial_num
    },
    processor: {
        Type: $processor_type,
        Version: $processor_version,
        max_speed: $max_sp,
        current_sp: $current_sp
    },
    memory: {
        installed_num: $mem_num,
        max_capacity: $max_capacity
    }
}